@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<h2>Edit Event</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="EditEvent"
      asp-route-id="@Model.EventID"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="EventID" />

    <div class="mb-3">
        <label asp-for="EventName"></label>
        <input asp-for="EventName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="EventDate"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EventType"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Running">Running</option>
            <option value="Walking">Walking</option>
            <option value="Cycling">Cycling</option>
        </select>
    </div>

    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <p>Current banner:</p>
        <img src="@Model.BannerImageUrl"
             alt="Current event banner"
             style="max-width:250px" />
    }

    <!-- Selecting a new image replaces the existing banner if the API supports it. -->
    <div class="mb-3">
        <label asp-for="BannerImage">New Banner Image</label>
        <input asp-for="BannerImage"
               type="file"
               accept="image/*"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Events" class="btn btn-secondary">Cancel</a>
</form>
