@model List<RaceDayMVC.Models.EnrollmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<h2>Participants Enrolled in Event</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Participant</th>
            <th>Category</th>
            <th>Enrolment Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ParticipantName</td>
                <td>@item.CategoryName</td>
                <td>@item.EnrollmentDate.ToString("dd MMM yyyy")</td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Events" class="btn btn-secondary">Back to Events</a>