@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<h2>Upcoming RaceDay Events</h2>

<p>Welcome, @Context.Session.GetString("FirstName")!</p>

<!-- Search and filter form. -->
<form method="get" asp-action="Index" class="row mb-4">

    <div class="col-md-5">
        <input name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search event or location..." />
    </div>

    <div class="col-md-4">
        <select name="eventType" class="form-select">
            <option value="">All Event Types</option>

            <option value="Running"
                    selected="@(ViewBag.EventType?.ToString() == "Running")">
                Running
            </option>

            <option value="Walking"
                    selected="@(ViewBag.EventType?.ToString() == "Walking")">
                Walking
            </option>

            <option value="Cycling"
                    selected="@(ViewBag.EventType?.ToString() == "Cycling")">
                Cycling
            </option>
        </select>
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No upcoming events were found.
    </div>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">

                @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                {
                    <img src="@item.BannerImageUrl"
                         class="card-img-top"
                         alt="Event banner"
                         style="height:180px;object-fit:cover" />
                }

                <div class="card-body">
                    <h5 class="card-title">@item.EventName</h5>

                    <p>@item.Description</p>

                    <p>
                        <strong>Date:</strong>
                        @item.EventDate.ToString("dd MMM yyyy")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @item.Location
                    </p>

                    <p>
                        <strong>Type:</strong>
                        @item.EventType
                    </p>

                    <a asp-action="EventDetails"
                       asp-route-id="@item.EventID"
                       class="btn btn-primary">
                        View Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>
