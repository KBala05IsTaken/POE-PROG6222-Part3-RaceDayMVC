@model List<RaceDayMVC.Models.EnrollmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<h2>My Event Enrolments</h2>

@if (Model.Count == 0)
{
    <p>You have not enrolled in any events yet.</p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Event</th>
            <th>Event Date</th>
            <th>Category</th>
            <th>Enrolment Date</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                <td>@item.CategoryName</td>
                <td>@item.EnrollmentDate.ToString("dd MMM yyyy")</td>
                <td>
                    <span class="badge bg-info">@item.Status</span>
                </td>
            </tr>
        }
    </tbody>
</table>
